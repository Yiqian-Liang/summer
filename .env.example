GEMINI_API_KEY=
SERPAPI_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional separate model for grounded opportunity search
GEMINI_SEARCH_MODEL=
# Email drafting uses free local templates unless explicitly enabled.
ENABLE_AI_DRAFTING=0
# Project fit analysis stays local unless both this flag and GEMINI_API_KEY are set.
ENABLE_MATCH_AI=0
# Local development only; emits recovery links to the local server console.
# Keep off in production until a transactional recovery-mail service is added.
ENABLE_DEV_PASSWORD_RESET=0

# Required only for POST /api/collect; send it in X-Admin-Token.
ADMIN_API_TOKEN=
# Optional stable salt for hashing anonymous rate-limit subjects.
RATE_LIMIT_SALT=

# Multiple mailboxes: a persistent Fernet key is required to encrypt credentials.
# Generate once: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MAIL_ENCRYPTION_KEY=
# The Render Blueprint sets this to its public HTTPS URL; use localhost locally.
SITE_BASE_URL=http://localhost:8000
# OAuth callback: SITE_BASE_URL/mail/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth callback: SITE_BASE_URL/mail/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional search controls
LIVE_SEARCH_MAX_REQUESTS=6
LIVE_SEARCH_TOTAL_TIMEOUT=25
LIVE_SEARCH_CACHE_SECONDS=600
SEARCH_REQUEST_TIMEOUT=15

# Sogou WeChat article search needs no API key; set to 0 to disable
ENABLE_SOGOU_WECHAT=1

# MediaCrawler checkout and one-command crawl+import settings
MEDIACRAWLER_PATH=MediaCrawler
MEDIACRAWLER_PLATFORMS=xhs,zhihu,bili,wb,tieba
MEDIACRAWLER_KEYWORDS=暑研,暑期科研,科研实习,暑研申请,课题组招生,博士招生,科研助理
MEDIACRAWLER_MAX_NOTES=20
MEDIACRAWLER_LOGIN_TYPE=qrcode

# Optional MediaCrawler JSON/JSONL/CSV export directory (auto-imported on startup)
MEDIACRAWLER_DATA_PATH=
